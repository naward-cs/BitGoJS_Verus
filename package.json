{
  "name": "@bitgo/utxo-lib",
  "version": "1.9.6",
  "description": "Client-side Bitcoin and Verus JavaScript library",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20",
    "npm": ">=11.1",
    "pnpm": ">=10.6",
    "yarn": ">=1.22"
  },
  "keywords": [
    "bitgo",
    "utxo",
    "bitcoinjs",
    "bitcoin",
    "zcash",
    "verus",
    "dash",
    "browserify",
    "javascript"
  ],
  "scripts": {
    "build": "pnpm tsc --build --incremental --verbose .",
    "clean": "rm -fr node_modules dist",
    "coverage-report": "nyc report --reporter=lcov",
    "coverage-html": "nyc report --reporter=html",
    "coverage": "npm run build && BITGO_UTXO_LIB_TEST_EXPECTED_COUNT=3594 nyc --check-coverage --branches 88 --functions 90 mocha",
    "format": "prettier --write '{src,test}/**/*.{ts,js}'",
    "lint": "eslint --quiet .",
    "integration-test": "mocha test/integration/",
    "standard": "standard",
    "test": "npm run standard && npm run coverage",
    "unit-test": "mocha --recursive"
  },
  "nyc": {
    "exclude": [
      "dist/**",
      "test/**"
    ]
  },
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miketout/BitGoJS.git#utxo-lib-verus"
  },
  "files": [
    "dist/src"
  ],
  "dependencies": {
    "@bitgo/blake2b": "3.2.4",
    "bech32": "2.0.0",
    "bigi": "1.4.2",
    "bip32": "5.0.0-rc.0",
    "bip66": "2.0.0",
    "bs58check": "4.0.0",
    "create-hash": "1.2.0",
    "create-hmac": "1.1.7",
    "debug": "~4.4.0",
    "ecurve": "1.0.6",
    "es-toolkit": "^1.36.0",
    "merkle-lib": "2.0.10",
    "randombytes": "2.1.0",
    "typeforce": "1.18.0",
    "varuint-bitcoin": "2.0.0",
    "verus-typescript-primitives": "git+https://github.com/VerusCoin/verus-typescript-primitives.git",
    "wif": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/bn.js": "5.1.6",
    "@types/ecurve": "^1.0.3",
    "@types/fs-extra": "11.0.4",
    "@types/mocha": "10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "axios": "1.8.4",
    "bip39": "3.1.0",
    "bip65": "1.0.3",
    "bs58": "6.0.0",
    "dhttp": "3.0.3",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.10",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-prettier": "^5.2.6",
    "fs-extra": "11.3.0",
    "globals": "^16.0.0",
    "minimaldata": "1.0.2",
    "mocha": "11.1.0",
    "nyc": "17.1.0",
    "prettier": "^3.5.3",
    "proxyquire": "2.1.3",
    "sinon": "20.0.0",
    "standard": "17.1.2",
    "ts-node": "10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "resolutions": {
    "ansi-regex": "5.0.1",
    "elliptic": "6.6.1"
  },
  "license": "MIT",
  "optionalDependencies": {
    "secp256k1": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "secp256k1",
      "tiny-secp256k1"
    ],
    "ignoredBuiltDependencies": [
      "es5-ext"
    ]
  }
}